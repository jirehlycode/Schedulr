{
  "name": "schedulr",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted scheduling app: event types, weekly availability, public booking pages.",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning src/server.js",
